# ============================================================
# PGConnect Monorepo .gitignore
# ============================================================

# ---- Environment & Secrets --------------------------------
.env
.env.*
!.env.example
!.env.*.example

# ---- Node / Next.js ---------------------------------------
node_modules/
.pnp
.pnp.js
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Python / FastAPI / Worker ----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ---- Alembic ----------------------------------------------
# Keep alembic/versions tracked
alembic/__pycache__/

# ---- OS ---------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ---- IDEs -------------------------------------------------
.idea/
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln

# ---- Docker -----------------------------------------------
*.dockerignore

# ---- Logs -------------------------------------------------
logs/
*.log

# ---- Misc -------------------------------------------------
*.bak
*.tmp
