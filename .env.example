# ============================================================
# PGConnect — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.
# ============================================================

# ---- Supabase (browser-safe) ------------------------------
# Obtain from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (server-only — never expose to browser) -----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ---- PostgreSQL (direct connection for FastAPI + Alembic) --
# Use Supabase connection pooler (port 6543) for app
# Use direct connection (port 5432) for Alembic migrations
DATABASE_URL=postgresql+asyncpg://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---- Redis ------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- FastAPI ----------------------------------------------
API_SECRET_KEY=change-me-to-a-random-256-bit-secret
API_CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# ---- Next.js Frontend -------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Supabase Storage -------------------------------------
SUPABASE_STORAGE_BUCKET_PG_MEDIA=pg-media

# ---- Email (optional — leave blank to disable email delivery)
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@pgconnect.in

# ---- Worker -----------------------------------------------
WORKER_CONCURRENCY=10
WORKER_MAX_JOBS=100
